# PostgreSQL
POSTGRES_USER=treenotes_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=treenotes_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@treenotes.com
PGADMIN_DEFAULT_PASSWORD=admin

# Dev login (seeded by migration; for reference only, not read from env)
# email: dev@treenotes.local
# password: demo1234

# Neo4j
# Holds the per-note concept graph. Postgres remains the system of record for
# note content; see NEO4J_INTEGRATION_PLAN.md for the dividing rule.
# The password must be at least 8 characters or the container exits on boot.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_graph

# Ollama
OLLAMA_URL=http://ollama:11434/api/generate
SMALL_MODEL_NAME=qwen2.5-coder:latest
LARGE_MODEL_NAME=qwen2.5-coder:14b
# OLLAMA_MODEL=qwen2.5-coder:latest # any other model you prefer and have installed
